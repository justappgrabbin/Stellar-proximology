    "allow": [
      "opportunity.needs.open",
      "capability.resolve.external",
      "opportunity.evaluate",
      "opportunity.authority",
      "consent.collaboration.accept",
      "consent.install.approve",
      "consent.verify",
      "consent.revoke",
      "deployment.authorized",
      "outcome.record",
      "opportunity.history",
      "opportunity.ledger.verify"
    ],
    "publicCapabilities": [
      "opportunity.needs.open",
      "capability.resolve.external"
    ]
  },
  "provenance": {
    "archive": "Synthia-MCP-Opportunity-Consent-v1.0.zip",
    "versionObserved": "1.1.0"
  },
  "metadata": {
    "assemblyStatus": "adapter-wired",
    "resolutionOrder": ["local", "organism", "network", "mcp", "human"],
    "installationRequiresSeparateConsent": true,
    "silentInstallation": false
  }
}
