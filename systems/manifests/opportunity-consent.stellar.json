{
  "id": "synthia-opportunity-consent",
  "name": "Synthia MCP Opportunity & Consent",
  "kind": "capability-membrane",
  "version": "1.1.0",
  "capabilities": [
    {"name": "opportunity.needs.open"},
    {"name": "capability.resolve.external"},
    {"name": "opportunity.evaluate"},
    {"name": "opportunity.authority"},
    {"name": "consent.collaboration.accept"},
    {"name": "consent.install.approve"},
    {"name": "consent.verify"},
    {"name": "consent.revoke"},
    {"name": "deployment.authorized"},
    {"name": "outcome.record"},
    {"name": "opportunity.history"},
    {"name": "opportunity.ledger.verify"}
  ],
  "requirements": [],
  "interfaces": {
    "adapter": "integration/adapters/opportunity-consent-provider.mjs",
    "source": "Synthia-MCP-Opportunity-Consent/src/create-organism.js"
  },
  "events": {
    "emits": ["science.external-opportunity.recorded", "external.outcome"],
    "listens": []
